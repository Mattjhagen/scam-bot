# --- Twilio (required for live calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12025551234
PUBLIC_HOST=your-domain.example.com

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
# For local/self-hosted models:
# OPENAI_BASE_URL=http://localhost:1234/v1

# --- AWS (for Polly TTS and S3 recording storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Joanna
S3_RECORDING_BUCKET=

# --- Database ---
DATABASE_URL=sqlite:///./data/scam_bot.db

# --- Redis (for background tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Settings ---
TTS_PROVIDER=polly        # "polly", "gtts", or "whisper-tts"
ENABLE_LOCAL_TTS=false
RECORD_CALLS=true
RECORDING_DIR=./data/recordings
SEND_SMS_NOTES=true
NOTIFICATION_FROM=+12025551234
MIN_SCAM_CONFIDENCE=0.7
DEFAULT_PERSONA=confused_cia_agent
ENV=development
DEBUG=true

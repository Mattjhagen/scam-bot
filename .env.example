# --- Twilio (required) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12025551234
PUBLIC_HOST=your-domain.example.com

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- AWS (for Polly TTS) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Joanna

# --- Notification (required for SMS summaries) ---
OWNER_PHONE=+12025551234  # Where call summaries are sent (never the scammer's number)

# --- API Auth ---
API_KEY=  # Required to access /api/* endpoints. Set to a strong random string.

# --- Database ---
DATABASE_URL=sqlite:///./data/scam_bot.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Settings ---
TTS_PROVIDER=polly        # "polly", "gtts"
RECORD_CALLS=true
RECORDING_DIR=./data/recordings
RECORDING_RETENTION_DAYS=30
SEND_SMS_NOTES=true
MIN_SCAM_CONFIDENCE=0.7
SCAM_REPORT_THRESHOLD=3   # Reports needed before a number is auto-blocked
DEFAULT_PERSONA=confused_cia_agent
ENV=development
DEBUG=false
